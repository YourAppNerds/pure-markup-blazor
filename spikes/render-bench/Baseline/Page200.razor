@* Generated by gen.mjs. *@
@inherits BenchBase
@implements IBenchTarget
<main class="page">
<section class="card" id="s1">
    <h2 class="title">Section 1: @Title</h2>
    <p class="lead">Intro text for section 1 with a <span class="hl">highlight</span>.</p>
    <ul class="links">
        <li><a href="/s1/a">Link A</a></li>
        <li><a href="/s1/b">Link B</a></li>
        <li><a href="/s1/c">Link C</a></li>
        <li><a href="/s1/d">Link D</a></li>
    </ul>
    <div class="@(Active == 1 ? "row active" : "row")">
        <button type="button" class="btn" @onclick="() => Click(1)">Open 1</button>
        <Badge Label="S1" Count="@Count" />
        <span class="count">@Count</span>
    </div>
    @if (ShowExtra)
    {
        <p class="extra">Extra details for section 1.</p>
    }
    <img src="/img/1.png" alt="Image 1" />
    <input type="text" placeholder="Name 1" value="@Name" />
    <p class="foot">Updated by @Name</p>
</section>
