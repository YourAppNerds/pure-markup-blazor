<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- Razor baseline: the same pages written as .razor, compiled by the Razor SDK.
       Components package, not the shared framework, so WasmBench can run it in the browser too. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>
</Project>
