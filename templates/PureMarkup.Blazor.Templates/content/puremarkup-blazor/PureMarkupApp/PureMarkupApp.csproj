<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- blazor.web.js ships in Microsoft.AspNetCore.App.Internal.Assets; the SDK only adds it when a .razor file exists. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PureMarkup.Blazor" Version="0.1.0-preview.1" />
<!--#if (UseWebAssembly) -->
    <ProjectReference Include="..\PureMarkupApp.Client\PureMarkupApp.Client.csproj" />
<!--#if (IsNet11) -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="11.0.0-*" />
<!--#else -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
<!--#endif -->
<!--#endif -->
  </ItemGroup>

</Project>