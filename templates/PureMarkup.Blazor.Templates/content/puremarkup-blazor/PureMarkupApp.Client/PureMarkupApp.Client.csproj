<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Trim warnings while you build. Not IsTrimmable: the server names interactive components by type at runtime,
         so a trimmable app assembly loses its pages on publish ("Root component type ... could not be found"). -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PureMarkup.Blazor" Version="0.1.0-preview.2" />
<!--#if (IsNet11) -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-*" />
<!--#else -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
<!--#endif -->
  </ItemGroup>

</Project>