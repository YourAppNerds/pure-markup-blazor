<Project Sdk="Microsoft.NET.Sdk">
  <!-- Consumer-time generation against a real third-party library: [assembly: GenerateMarkup(...)] for MudBlazor components. -->
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="bunit" />
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <ProjectReference Include="..\..\src\PureMarkup.Blazor\PureMarkup.Blazor.csproj" />
    <!-- Also referenced as an assembly: the whole-assembly test drives the generator on MudBlazor directly. -->
    <ProjectReference Include="..\..\src\PureMarkup.Blazor.Generators\PureMarkup.Blazor.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" Aliases="gen" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="PureMarkup.Blazor" />
    <Using Include="PureMarkup.Blazor.H" Static="true" />
    <Using Include="MudBlazor" />
  </ItemGroup>
</Project>
