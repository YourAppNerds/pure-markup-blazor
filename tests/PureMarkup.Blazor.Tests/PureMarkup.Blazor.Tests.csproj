<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <!-- RenderTree types are "for framework use"; the tests inspect frames and edits. -->
    <NoWarn>$(NoWarn);BL0006</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Verify.Xunit" />
    <ProjectReference Include="..\..\src\PureMarkup.Blazor\PureMarkup.Blazor.csproj" />
    <!-- Also referenced as an assembly: ComponentModelTests drive the shared component model directly. -->
    <ProjectReference Include="..\..\src\PureMarkup.Blazor.Generators\PureMarkup.Blazor.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" Aliases="gen" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="PureMarkup.Blazor" />
    <Using Include="PureMarkup.Blazor.H" Static="true" />
    <Using Include="PureMarkup.Blazor.Styling" />
    <Using Include="PureMarkup.Blazor.Styling.CssUnits" Static="true" />
  </ItemGroup>
</Project>
