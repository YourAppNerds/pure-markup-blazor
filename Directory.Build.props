<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The .Bind interceptor lives in this namespace; the package will ship this line in build/*.props. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);PureMarkup.Blazor.Generated</InterceptorsNamespaces>
    <!-- Packages (library and templates) share one version. A tag v<Version> publishes them to nuget.org (.github/workflows/release.yml). -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.2</VersionSuffix>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages/</PackageOutputPath>
    <Authors>YourAppNerds</Authors>
    <Company>YourAppNerds</Company>
    <Copyright>Copyright (c) YourAppNerds</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/YourAppNerds/pure-markup-blazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/YourAppNerds/pure-markup-blazor</PackageProjectUrl>
    <PackageTags>blazor;markup;csharp;css-in-csharp;source-generator</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup Condition="'$(IsTestProject)' == 'true' or $(MSBuildProjectDirectory.Contains('benchmarks')) or $(MSBuildProjectDirectory.Contains('samples'))">
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
