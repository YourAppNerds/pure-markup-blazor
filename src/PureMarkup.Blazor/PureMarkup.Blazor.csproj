<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>PureMarkup.Blazor</RootNamespace>
    <Description>C# markup for Blazor: components, pages and layouts without .razor files.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <!-- Sequence numbers are computed at runtime by design (slot in parent). -->
    <NoWarn>$(NoWarn);ASP0006</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Generated element/attribute/event methods are documented by the data file, not per method. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <AdditionalFiles Include="Html/html.data" />
    <AdditionalFiles Include="Css/css.data" />
    <ProjectReference Include="..\PureMarkup.Blazor.Generators\PureMarkup.Blazor.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <InternalsVisibleTo Include="PureMarkup.Blazor.Tests" />
  </ItemGroup>

  <!-- Package: the library, its source generator (analyzers/), build props/targets (build/), and the CSS build tool (tools/). -->
  <ItemGroup>
    <ProjectReference Include="..\PureMarkup.Blazor.CssTool\PureMarkup.Blazor.CssTool.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" PrivateAssets="all" />
    <None Include="build\PureMarkup.Blazor.props;build\PureMarkup.Blazor.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>
  <!-- NuGet readme: the repo README with relative links rewritten to absolute GitHub URLs. -->
  <Target Name="_PureMarkupPackReadme" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <PropertyGroup>
      <_PmReadmeOut>$(IntermediateOutputPath)PACKAGE.README.md</_PmReadmeOut>
      <_PmReadmeText>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\README.md'))</_PmReadmeText>
      <_PmReadmeText>$([System.Text.RegularExpressions.Regex]::Replace('$(_PmReadmeText)', '\]\((?!https?:|#|mailto:)([^)\s]+)\)', '](https://github.com/YourAppNerds/pure-markup-blazor/blob/main/$1)'))</_PmReadmeText>
    </PropertyGroup>
    <WriteLinesToFile File="$(_PmReadmeOut)" Lines="$(_PmReadmeText)" Overwrite="true" />
    <ItemGroup>
      <None Include="$(_PmReadmeOut)" Pack="true" PackagePath="README.md" />
      <FileWrites Include="$(_PmReadmeOut)" />
    </ItemGroup>
  </Target>
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_PureMarkupPackExtras</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <Target Name="_PureMarkupPackExtras">
    <PropertyGroup>
      <_PmGenDir>$(MSBuildThisFileDirectory)..\PureMarkup.Blazor.Generators\bin\$(Configuration)\netstandard2.0\</_PmGenDir>
      <_PmToolDir>$(MSBuildThisFileDirectory)..\PureMarkup.Blazor.CssTool\bin\$(Configuration)\net10.0\</_PmToolDir>
    </PropertyGroup>
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(_PmGenDir)PureMarkup.Blazor.Generators.dll" PackagePath="analyzers\dotnet\cs\" />
      <TfmSpecificPackageFile Include="$(_PmToolDir)PureMarkup.Blazor.CssTool.dll;$(_PmToolDir)PureMarkup.Blazor.CssTool.runtimeconfig.json;$(_PmToolDir)PureMarkup.Blazor.CssTool.deps.json"
                              PackagePath="tools\" />
    </ItemGroup>
    <Error Condition="!Exists('$(_PmGenDir)PureMarkup.Blazor.Generators.dll') Or !Exists('$(_PmToolDir)PureMarkup.Blazor.CssTool.dll')"
           Text="Build the generator and CSS tool ($(Configuration)) before packing." />
  </Target>
</Project>
